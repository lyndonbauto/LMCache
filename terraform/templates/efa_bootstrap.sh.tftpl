# Shared EFA bootstrap, inlined into each node's user-data.
# Installs the pinned aws-efa-installer and leaves a marker file so the runbook
# can tell "EFA not installed yet" apart from "EFA installed but not working".

set -euxo pipefail

dnf -y update
# Do NOT add gnupg2 here: it conflicts with the preinstalled gnupg2-minimal on
# Amazon Linux 2023 and fails the whole transaction. The missing gpg-agent is
# handled at the import call instead (see below).
dnf -y install gcc gcc-c++ make cmake git pciutils tar wget jq python3-pip

EFA_VERSION="${efa_installer_version}"
cd /opt
curl -fsSL -o aws-efa-installer.tar.gz \
  "https://efa-installer.amazonaws.com/aws-efa-installer-$${EFA_VERSION}.tar.gz"

# Verify the tarball against AWS's published GPG key before running it as root.
#
# --batch --no-tty and a scratch GNUPGHOME are mandatory here, not hygiene:
# cloud-init runs with no controlling terminal and no writable default
# ~/.gnupg, so a plain `gpg --import` fails with "cannot open '/dev/tty'" and,
# under `set -e`, aborts the entire bootstrap before anything is installed.
export GNUPGHOME
GNUPGHOME=$(mktemp -d)
curl -fsSL -o aws-efa-installer.key https://efa-installer.amazonaws.com/aws-efa-installer.key
curl -fsSL -o aws-efa-installer.tar.gz.sig \
  "https://efa-installer.amazonaws.com/aws-efa-installer-$${EFA_VERSION}.tar.gz.sig" || true
if [ -s aws-efa-installer.tar.gz.sig ]; then
  # `|| true` on the import ONLY. Amazon Linux 2023 ships gpg without
  # gpg-agent, so --import returns exit 2 even though the key imports
  # correctly ("imported: 1" in the log). Under `set -e` that aborts the whole
  # bootstrap at a point where the log looks like success.
  #
  # The security property is preserved: --verify does not need the agent, it
  # works, and it is deliberately NOT suffixed with `|| true` -- a bad or
  # missing signature still aborts the bootstrap.
  gpg --batch --no-tty --import aws-efa-installer.key || true
  gpg --batch --no-tty --verify aws-efa-installer.tar.gz.sig aws-efa-installer.tar.gz
fi

tar -xf aws-efa-installer.tar.gz
cd aws-efa-installer
# -y unattended, -g installs the GDRCopy/libfabric stack.
# NOT passing --minimal: we want fi_info, fi_pingpong and the ibverbs tooling
# present, because the runbook's EFA verification depends on them.
./efa_installer.sh -y

echo "$${EFA_VERSION}" > /var/log/efa-installed-version
