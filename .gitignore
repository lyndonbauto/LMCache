# Terraform state may contain sensitive values and is environment-specific.
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
crash.log

# Real variable values, including the operator's IP.
terraform.tfvars
*.auto.tfvars

# Saved plans.
*.tfplan

# Benchmark output.
#
# results/ is deliberately NOT ignored: these are small text artifacts pulled
# off instances that no longer exist, and they are the deliverable. Losing them
# to a wildcard would mean re-renting a $58/hr cluster to regenerate them.
*.svg

# Aerospike Enterprise license file -- never commit.
features.conf
*.features.conf
