+        """
+        True if any child needs its layer-by-layer hooks in this step.
+        """
+        assert isinstance(metadata, MultiKVConnectorMetadata)
+        return any(
+            c.requires_piecewise_for_step(cm)
+            for c, cm in zip(self._connectors, metadata.metadata)
+        )
